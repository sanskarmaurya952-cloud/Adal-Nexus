# Copy to .env and fill in locally. Never commit .env. Never paste a real key into chat, docs or tests.
PORT=3001

# LLM provider: "gemini" (default) or "none". The app starts and works without a key;
# only plan generation needs one.
LLM_PROVIDER=gemini

# Get a key at https://aistudio.google.com/apikey (free tier, no billing needed).
GEMINI_API_KEY=

# Model id. Check https://ai.google.dev/gemini-api/docs/pricing for which models currently have a
# free tier; availability, limits and the model list change. gemini-2.5-flash-lite and
# gemini-3.8-flash were listed there as free-of-charge on 2026-10-27, but free-tier quota is
# limited and not guaranteed, and free-tier content may be used to improve Google products.
GEMINI_MODEL=gemini-2.5-flash-lite

# Browser used by browser.search / browser.open / browser.extract. The window is always visible.
#   BROWSER_CHANNEL=chrome   -> use your installed Google Chrome (no download needed)
#   BROWSER_CHANNEL=msedge   -> use installed Microsoft Edge
#   (empty)                  -> Playwright's bundled Chromium; install once with:
#                               npx playwright-core install chromium
BROWSER_CHANNEL=

# ==============================================================================
# Google Drive Picker Integration (Phase 2 - Social Media Autopilot)
# Required only if you want to pick media assets directly from Google Drive.
# The app works with local file upload if these are left blank.
#
# Obtain these from Google Cloud Console (https://console.cloud.google.com):
# 1. VITE_GOOGLE_CLIENT_ID: OAuth 2.0 Web Application Client ID.
#    Authorized JavaScript Origin must include your web origin (e.g. http://localhost:5173).
# 2. VITE_GOOGLE_API_KEY: Browser API Key with API restrictions set to:
#    - Google Picker API
#    - Google Drive API
#    And HTTP referrers restriction including your origin and https://docs.google.com/*
# 3. VITE_GOOGLE_APP_ID: Your Google Cloud Project Number (numeric project number).
# ==============================================================================
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# ==============================================================================
# Social Media Autopilot — Publishing Provider (Phase 3A)
# Options: "mock" (safe local simulation, zero network requests) or leave empty (disabled).
# Note: Personal Instagram accounts cannot publish to Instagram via Meta Graph API.
# "mock" allows testing state transitions, persistence, and UI safely without live posting.
# Any other value or missing fails closed with HTTP 503.
# ==============================================================================
SOCIAL_PUBLISHING_PROVIDER=mock

# ==============================================================================
# LinkedIn Official API Integration (Phase 3.2)
# Required to publish real posts and images to LinkedIn via Official Posts API.
#
# Obtain these from the LinkedIn Developer Portal (https://www.linkedin.com/developers):
# 1. Create a LinkedIn Developer Application.
# 2. Add products:
#    - "Share on LinkedIn"
#    - "Sign In with LinkedIn using OpenID Connect"
# 3. In the "Auth" tab, configure your authorized redirect URL:
#    http://localhost:3001/api/social/linkedin/callback
# 4. Fill in Client ID and Client Secret below:
# ==============================================================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/social/linkedin/callback

# Optional: Alternatively, you can directly provide a valid 60-day OAuth 2.0 User Access Token
# generated via the LinkedIn Developer Token Generator with w_member_social and openid scopes.
LINKEDIN_ACCESS_TOKEN=


