{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": "src/desktop",
    "types": ["node", "electron"]
  },
  "include": ["src/desktop/**/*"],
  "exclude": ["src/desktop/**/*.test.ts", "src/desktop/verify-*.ts"]
}
